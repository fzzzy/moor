// test_that_hashing_works
@programmer

; return string_hash("abc");
"BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD"

; return string_hash("abc", "md5");
"900150983CD24FB0D6963F7D28E17F72"

; return string_hash("abc", "sha1");
"A9993E364706816ABA3E25717850C26C9CD0D89D"

; return string_hash("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq");
"248D6A61D20638B8E5C026930C3E6039A33CE45964FF2167F6ECEDD419DB06C1"

; return binary_hash(b"AAAAAAA=");
"8855508AADE16EC573D21E6A485DFD0A7624085C1A14B5ECDD6485DE0C6839A4"

; return typeof(binary_hash(b"AAAAAAA=", "sha256", 1));
17

; return value_hash({});
"E7DB545155EA0083E6CD2CC13E2F4200451E8205C342A2A257BA962F47CD6016"

; $tmp = {1, 2, 3, {"fee", "fi", "fo", "fum"}};
; return value_hash($tmp);
"1AA477E97BC889822F44603D8A717D1C592D5862F134FF9913FED9B2145E24BB"

; return typeof(value_hash($tmp, "sha256", 1));
17

// test_that_procedural_builtins_are_repeatable
@programmer

; return toint(noise_2d(0.3, 0.7, 42) * 1000000.0);
692706

; return toint(noise_2d(5.5, 1.25, 3, ["octaves" -> 4, "frequency" -> 0.1]) * 1000000.0);
-468291

; return {length(noise_grid(10, 20, 16, 4, 7)), length(noise_grid(10, 20, 16, 4, 7)[1])};
{4, 16}

; return noise_grid(10.0, 20.0, 3, 2, 7)[2][3] == noise_2d(12.0, 21.0, 7) ? 1 | 0;
1

; return random_at(7, {10, -20}, 100);
95

; return random_at(7, {10, -20}) == random_at(7, {10, -20}) ? 1 | 0;
1

; return `noise_2d(1, 2, 3, ["octaves" -> 0]) ! E_INVARG => 1';
1

; return `noise_2d(1, 2, 3, ["wiggle" -> 1]) ! E_INVARG => 1';
1

; return `noise_grid(0, 0, 300, 300, 1) ! E_INVARG => 1';
1

; return `random_at(1, {"a"}) ! E_TYPE => 1';
1

; return `random_at(1, {1}, 0) ! E_INVARG => 1';
1

; return floatstr(noise_2d(12.5, -3.0, 42), 6);
"-0.431678"
