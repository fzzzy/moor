// Packed integer fields in binary values
@programmer

// Width 5: the second entry spans the first two bytes, lowest bit first.
; return encode_base64(binary_pack({22, 13, 31}, 5));
"tn0="

; return binary_unpack(binary_pack({22, 13, 31}, 5), 5);
{22, 13, 31}

// Only whole entries count: 2 bytes hold three 5-bit entries.
; return length(binary_unpack(binary_pack({1, 2, 3}, 5), 5));
3

; return binary_unpack(binary_pack({1, 2, 3, 4, 5, 6}, 4), 4, 3);
{3, 4, 5, 6}

; return binary_unpack(binary_pack({1, 2, 3, 4, 5, 6}, 4), 4, 2, 3);
{2, 3, 4}

; return binary_unpack(binary_pack({1, 2}, 4), 4, 3, 0);
{}

; return binary_field(binary_pack({7, 4095, 0}, 12), 12, 2);
4095

; return binary_unpack(binary_set_field(binary_pack({1, 2, 3}, 12), 12, 2, 4000), 12);
{1, 4000, 3}

// The value passed in is not changed.
; const b = binary_pack({1, 2, 3}, 3); binary_set_field(b, 3, 1, 7); return binary_unpack(b, 3, 1, 3);
{1, 2, 3}

// Later changes to the same index win.
; return binary_unpack(binary_set_fields(binary_pack({0, 0, 0, 0}, 2), 2, {{1, 3}, {4, 2}, {1, 1}}), 2);
{1, 0, 0, 2}

; return binary_unpack(binary_pack({4294967295, 0}, 32), 32);
{4294967295, 0}

// The bits that fill out the last byte read as zero entries, so pass a count to get back exactly
// what was packed.
; return binary_unpack(binary_pack({1, 2, 3}, 3), 3);
{1, 2, 3, 0, 0}

// A palette that outgrows its width is repacked.
; return binary_unpack(binary_pack(binary_unpack(binary_pack({15, 0, 9}, 4), 4, 1, 3), 5), 5, 1, 3);
{15, 0, 9}

; return binary_pack({}, 8) == binary_from_str("");
1

; return `binary_pack({1}, 0) ! E_INVARG => 1';
1

; return `binary_pack({1}, 33) ! E_INVARG => 1';
1

; return `binary_pack({16}, 4) ! E_INVARG => 1';
1

; return `binary_pack({-1}, 4) ! E_INVARG => 1';
1

; return `binary_pack({"x"}, 4) ! E_TYPE => 1';
1

; return `binary_field(binary_pack({1, 2}, 8), 8, 3) ! E_RANGE => 1';
1

; return `binary_field(binary_pack({1, 2}, 8), 8, 0) ! E_RANGE => 1';
1

; return `binary_unpack(binary_pack({1, 2}, 8), 8, 2, 2) ! E_RANGE => 1';
1

; return `binary_set_field(binary_pack({1}, 4), 4, 1, 16) ! E_INVARG => 1';
1

; return `binary_set_fields(binary_pack({1}, 4), 4, {{1}}) ! E_TYPE => 1';
1

; return `binary_set_fields(binary_pack({1}, 4), 4, {{3, 1}}) ! E_RANGE => 1';
1
